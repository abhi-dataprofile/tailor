# ── Copy to `.env` and fill in. Nothing here is committed. ──────────────
# Cloud storage + multi-user + background auto-apply (all optional).
# Leave blank to run fully local (localStorage only, no background jobs).

# Supabase — the system of record. Create a free project at supabase.com,
# then Project Settings → API. Run db/schema.sql in the SQL editor first.
SUPABASE_URL=
SUPABASE_ANON_KEY=            # "anon public" key — safe for the browser
SUPABASE_SERVICE_KEY=         # "service_role" key — SERVER ONLY, never ship to the browser

# LLM providers used by the backend pipeline (any one is enough; else heuristics)
CLAUDE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Background auto-apply tuning (safe defaults shown)
APPLY_BROWSER=1              # 1 = use the Playwright browser engine for submitting
APPLY_MIN_SCORE=45          # only auto-apply above this match score
APPLY_MAX_PER_USER=10       # cap applications per user per run
APPLY_RATE_SLEEP=8          # seconds between applications (be polite)
APPLY_MAX_RETRIES=2

# Crawler tuning — defaults cycle the full ~15.9k dataset about once an hour
JOB_REFRESH_HOURS=1         # re-crawl each company at least this often
CRAWL_BATCH=90              # companies per cycle (raise to cover more per hour)
CRAWL_CONCURRENCY=16
CRAWL_SLEEP=20              # seconds between cycles

# Contacts / billing / inbox (optional — see contacts.py / billing.py / inbox.py)
APOLLO_API_KEY=
HUNTER_API_KEY=
STRIPE_SECRET_KEY=
